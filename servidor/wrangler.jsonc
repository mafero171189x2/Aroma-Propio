{
  // Configuración del Worker de Aroma Propio (Cloudflare lee este archivo desde GitHub)
  "name": "aroma-propio-api",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aroma-propio",
      // Pegá acá el "Database ID" que te muestra Cloudflare al crear la base
      "database_id": "PEGAR-ACA-EL-DATABASE-ID"
    }
  ],

  // Los secretos (JWT_SECRET y ADMIN_PASSWORD) NO van acá: se cargan en el panel de Cloudflare
  "vars": {
    "ALLOWED_ORIGIN": "https://mafero171189x2.github.io",
    "CATALOGO_URL": "https://mafero171189x2.github.io/Aroma-Propio/datos.json"
  }
}
